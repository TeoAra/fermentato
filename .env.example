# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=fermenta_to

# Session Configuration
SESSION_SECRET=your-very-long-random-session-secret-here

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Replit Auth Configuration (optional for local development)
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc
REPLIT_DOMAINS=localhost:5000,your-domain.com

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google reCAPTCHA v2 (optional - appears on login/register if set)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# Google OAuth (optional)
# Web client ID (login browser + server-side Passport)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Android client ID (login nativo APK — DEVE corrispondere al package to.fermenta.app)
GOOGLE_ANDROID_CLIENT_ID=131123139785-2hga67bhmf4q0ucuibq71paijrlastlj.apps.googleusercontent.com

# Android App Links (VPS production). Use the SHA-256 fingerprint printed by
# keytool for the Play App Signing certificate; separate multiple fingerprints
# with commas when supporting upload/internal and Play-installed builds.
ANDROID_CERT_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99

# Application Environment
NODE_ENV=development
