# ─────────────────────────────────────────────────────────────────────────────
# Fermenta.to — Build iOS via GitHub Actions
#
# QUESTO FILE NON È ATTIVO. Per attivarlo, rinominalo in `ios-build.yml`.
# Richiede un account Apple Developer (99$/anno) e i seguenti GitHub secrets:
#
#   APPLE_CERT_P12              — certificato di distribuzione esportato in .p12
#                                 (esporta da Keychain Access, poi base64 -i cert.p12)
#   APPLE_CERT_PASSWORD         — password del .p12
#   APPLE_PROVISIONING_PROFILE  — provisioning profile App Store (.mobileprovision)
#                                 codificato base64
#   APP_STORE_CONNECT_API_KEY   — chiave API App Store Connect (.p8) base64
#   APP_STORE_CONNECT_KEY_ID    — Key ID della chiave (es. ABC1234DEF)
#   APP_STORE_CONNECT_ISSUER_ID — Issuer UUID dell'account App Store Connect
#   APPLE_TEAM_ID               — Team ID Apple Developer (10 caratteri alfanumerici,
#                                 visibile in https://developer.apple.com/account →
#                                 Membership Details)
#   KEYCHAIN_PASSWORD           — password temporanea per il keychain CI (random)
#
# Procedura per generare i secret:
#   1. Apple Developer → Certificates, IDs & Profiles → crea un certificato
#      di distribuzione iOS, esportalo in .p12 e converti in base64.
#   2. Crea un App ID `to.fermenta.app` con capability "Push Notifications".
#   3. Crea un Provisioning Profile App Store legato al certificato e all'App ID.
#   4. App Store Connect → Users and Access → Keys → genera una API Key con
#      ruolo "App Manager" e scarica il .p8.
#   5. Aggiungi tutti i secret nel repo GitHub (Settings → Secrets → Actions).
#
# Ogni run produce un .ipa in artifact e (opzionalmente) lo carica su TestFlight.
# ─────────────────────────────────────────────────────────────────────────────

name: iOS Build

on:
  workflow_dispatch:
  push:
    tags:
      - "ios-v*"

jobs:
  build:
    runs-on: macos-14
    timeout-minutes: 60

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node 20
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"

      - name: Install npm deps
        run: npm ci

      - name: Build web
        run: npm run build

      - name: Add iOS platform if missing
        run: |
          # La cartella ios/ NON è committata nel repo: viene generata
          # on-demand qui (vedi docs/ios-build.md). Idempotente.
          if [ ! -d "ios" ]; then
            npx cap add ios
          fi

      - name: Capacitor sync iOS
        run: npx cap sync ios

      - name: Generate iOS assets
        run: |
          npx --yes @capacitor/assets generate --ios \
            --iconBackgroundColor '#FFF7ED' \
            --splashBackgroundColor '#FFF7ED' || true

      - name: Apply Italian Info.plist
        # Eseguito DOPO cap add/sync così la cartella ios/App/App esiste sicuro.
        run: cp ios-template/App/App/Info.plist ios/App/App/Info.plist

      - name: Install CocoaPods
        working-directory: ios/App
        run: pod install

      - name: Import certificate and provisioning profile
        env:
          APPLE_CERT_P12: ${{ secrets.APPLE_CERT_P12 }}
          APPLE_CERT_PASSWORD: ${{ secrets.APPLE_CERT_PASSWORD }}
          APPLE_PROVISIONING_PROFILE: ${{ secrets.APPLE_PROVISIONING_PROFILE }}
          KEYCHAIN_PASSWORD: ${{ secrets.KEYCHAIN_PASSWORD }}
        run: |
          # Decodifica i secret
          echo "$APPLE_CERT_P12" | base64 --decode > /tmp/cert.p12
          echo "$APPLE_PROVISIONING_PROFILE" | base64 --decode > /tmp/profile.mobileprovision

          # Crea keychain temporaneo
          security create-keychain -p "$KEYCHAIN_PASSWORD" build.keychain
          security default-keychain -s build.keychain
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" build.keychain
          security set-keychain-settings -lut 21600 build.keychain

          # Importa il certificato
          security import /tmp/cert.p12 -k build.keychain -P "$APPLE_CERT_PASSWORD" \
            -T /usr/bin/codesign -T /usr/bin/xcodebuild
          security set-key-partition-list -S apple-tool:,apple:,codesign: \
            -s -k "$KEYCHAIN_PASSWORD" build.keychain

          # Installa il provisioning profile
          mkdir -p "$HOME/Library/MobileDevice/Provisioning Profiles"
          cp /tmp/profile.mobileprovision \
            "$HOME/Library/MobileDevice/Provisioning Profiles/"

      - name: Archive
        working-directory: ios/App
        env:
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
        run: |
          xcodebuild -workspace App.xcworkspace \
            -scheme App \
            -configuration Release \
            -archivePath $PWD/build/App.xcarchive \
            -destination 'generic/platform=iOS' \
            clean archive \
            CODE_SIGN_STYLE=Manual \
            DEVELOPMENT_TEAM="$APPLE_TEAM_ID"

      - name: Export IPA
        working-directory: ios/App
        run: |
          cat > /tmp/ExportOptions.plist <<'EOF'
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>method</key><string>app-store</string>
            <key>signingStyle</key><string>manual</string>
            <key>uploadSymbols</key><true/>
          </dict>
          </plist>
          EOF
          xcodebuild -exportArchive \
            -archivePath $PWD/build/App.xcarchive \
            -exportPath $PWD/build/ipa \
            -exportOptionsPlist /tmp/ExportOptions.plist

      - name: Upload IPA artifact
        uses: actions/upload-artifact@v4
        with:
          name: fermenta-ios-ipa
          path: ios/App/build/ipa/*.ipa

      - name: Upload to TestFlight (optional)
        if: startsWith(github.ref, 'refs/tags/ios-v')
        env:
          API_KEY: ${{ secrets.APP_STORE_CONNECT_API_KEY }}
          KEY_ID: ${{ secrets.APP_STORE_CONNECT_KEY_ID }}
          ISSUER_ID: ${{ secrets.APP_STORE_CONNECT_ISSUER_ID }}
        run: |
          mkdir -p ~/.appstoreconnect/private_keys
          echo "$API_KEY" | base64 --decode > ~/.appstoreconnect/private_keys/AuthKey_${KEY_ID}.p8
          xcrun altool --upload-app -f ios/App/build/ipa/*.ipa -t ios \
            --apiKey "$KEY_ID" --apiIssuer "$ISSUER_ID"
